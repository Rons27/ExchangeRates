{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "ExchangeRates": "Debug"
    }
  },
  "CnbApi": {
    "BaseUrl": "https://api.cnb.cz",
    "DailyRatesPath": "/cnbapi/exrates/daily",
    "TimeoutSeconds": 30,
    "RetryCount": 3
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  }
}
